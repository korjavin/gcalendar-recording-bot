# gcalendar-recording-bot configuration. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored — never commit real hosts, emails or keys. Under Portainer
# set the same variables in the stack environment instead.

# --- Compose / Traefik (read by docker-compose.yml, not by the bot) ----------
# Public host Traefik routes to the bot.
DOMAIN=notetaker.example.com
TRAEFIK_NETWORK_NAME=traefik
TRAEFIK_CERTRESOLVER=myresolver

# --- HTTP -------------------------------------------------------------------
# Public HTTPS base URL, no trailing slash. Google redirects to
# PUBLIC_URL/oauth/callback; recorders post to PUBLIC_URL/events and the
# transcriber to PUBLIC_URL/notify. Required.
PUBLIC_URL=https://notetaker.example.com
# Fixed by the image (:8080, /data), so not passed through.
#LISTEN_ADDR=:8080
#DATA_DIR=/data
# debug, info, warn or error.
LOG_LEVEL=info

# --- Google OAuth (required) ------------------------------------------------
# Web OAuth client from Google Cloud (see README, "Google Cloud setup").
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
# Encrypts stored refresh tokens: base64 of exactly 32 bytes. Generate with:
#   openssl rand -base64 32
# Changing it makes every stored connection unreadable (users reconnect).
TOKEN_KEY=change-me
# Only accounts in these domains may connect (comma-separated). Required.
ALLOWED_EMAIL_DOMAINS=example.com

# --- Bot identity -----------------------------------------------------------
# Address people invite to meetings. Must be a deliverable mailbox (an alias or
# plus-address is enough), or every invitation bounces. Required.
BOT_INVITE_EMAIL=notetaker@example.com
# Name the recorder joins the call with.
BOT_DISPLAY_NAME=NoteTaker

# --- Recorders (at least one recorder URL is required) ----------------------
# Shared HMAC key for x-recorder-signature, both directions; must equal the
# recorders' RECORDER_SECRET. Required. Generate with: openssl rand -hex 32
RECORDER_SECRET=change-me
# Links under this URL are Jitsi calls (no trailing slash). Required with
# JITSI_RECORDER_URL.
JITSI_BASE_URL=https://meet.jit.si
# Recorders on the shared network (container name and port). Leave one empty
# to disable that kind of meeting.
JITSI_RECORDER_URL=http://jitsi-recorder:8080
MEET_RECORDER_URL=http://meet-recorder:8080

# --- Transcriber (required) -------------------------------------------------
# Where recording.finished is delivered.
WEBHOOK_URL=http://transcriber:8000/webhook
# Signs the hand-off and verifies POST /notify; must equal the transcriber's
# WEBHOOK_SECRET. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me

# --- E-mail (optional) ------------------------------------------------------
# Leave SMTP_HOST empty to disable e-mail entirely (recordings still run, but
# nobody hears about them). Plain SMTP upgraded with STARTTLS (port 587 or 25;
# implicit-TLS port 465 is not supported). SMTP_FROM is required when
# SMTP_HOST is set; leave SMTP_USER empty for an unauthenticated relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notetaker@example.com

# --- Timing (seconds, all optional) -----------------------------------------
# How often connected calendars are read.
POLL_INTERVAL_S=300
# Start the recorder this long before the meeting.
JOIN_LEAD_S=90
# Give up if not admitted from the lobby within this long.
JOIN_TIMEOUT_S=1200
# Keep recording this long past the scheduled end.
OVERRUN_S=1800
# Stop after the room has been empty this long.
EMPTY_GRACE_S=60
# A shorter recording gets a "too short" e-mail and is not transcribed.
MIN_RECORDING_S=60
